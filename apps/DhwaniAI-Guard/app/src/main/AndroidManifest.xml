<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone permission for continuous audio listening -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Vibration for alerts -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Foreground service for background listening -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Notification for persistent service + alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DhwaniGuardApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="DhwaniAI Guard"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DhwaniAIGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DhwaniAIGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.AudioListenerService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

    </application>

</manifest>
